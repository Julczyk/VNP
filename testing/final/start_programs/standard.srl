$PARTS:
1.0, 1.0, 2.0, 1.0, 0.5, 0.5, 1.5;

$PROGRAMM
# ==============================================
# STANDARD - Standardowy zbieracz zasobow
# ==============================================
# Algorytm:
# 1. Skanuj w poszukiwaniu zasobow
# 2. Jesli zasob blisko (<=2) - zbieraj
# 3. Jesli daleko - idz w kierunku zasobu
# 4. Jesli brak zasobow - eksploruj zmieniajac kierunek
#
# Pamiec:
#   X[0] = energia (0.0-1.0)
#   X[1] = typ zasobu (0=brak, 1=IRON, 2=GOLD, 3=inne)
#   X[2] = kierunek (wynik skanera)
#   X[3] = dystans (wynik skanera)
#   X[10] = kierunek eksploracji (0-3)
#   X[11] = licznik krokow w kierunku
#
# Idle loop: zapobiegamy przez rotacje kierunkow co 4 kroki
# ==============================================

# Glowna petla
{
    # Krok 1: Skanuj otoczenie
    f_2(1.0, 1.0);

    # Krok 2: Sprawdz odleglosc
    # Jesli X[3] <= 1 (bezposredni sasiad) - zbieraj
    IF (1.5 - X[3]) {
        X[11] = 0.0;
        f_7(1.0);
    }

    # Jesli daleko (X[3] > 1) - idz w kierunku zasobu
    IF (X[3] - 1.5) {
        X[11] = 0.0;
        X[10] = X[2];
        f_1(X[2], 1.0);
    }

    # Jesli nie znaleziono (X[3] < 0) - eksploruj z rotacja kierunkow
    IF (0.0 - X[3]) {
        X[11] = X[11] + 1.0;

        # Zmien kierunek co 4 kroki
        IF (X[11] - 3.5) {
            X[11] = 0.0;
            X[10] = X[10] + 1.0;
            # Wrap kierunek do zakresu 0-3
            IF (X[10] - 3.5) {
                X[10] = 0.0;
            }
        }

        f_1(X[10], 1.0);
    }

    REDO;
}
