$PARTS:
4.0, 1.0, 1.0, 1.0, 0.5, 0.5, 1.0;

$PROGRAMM
# ==============================================
# BIG_ENGINE - Duzy silnik (Engine scale = 4.0)
# ==============================================
# Standardowa strategia, ale z przerosniętym silnikiem
# Szybsze podrozowanie, wieksze zuzycie energii
# ==============================================

{
    f_2(1.0, 1.0);

    IF (1.5 - X[2]) {
        f_7(1.0);
    }

    IF (X[2] - 1.5) {
        f_1(X[1], 1.0);
    }

    IF (0.0 - X[2]) {
        f_1(0.0, 1.0);
    }

    REDO;
}
