$PARTS:
1.0, 1.0, 5.0, 1.0, 0.5, 0.5, 1.0;

$PROGRAMM
# ==============================================
# BIG_STORAGE - Duzy magazyn (Storage scale = 5.0)
# ==============================================
# Inteligentna strategia z przerosniętym magazynem
# Wieksza pojemnosc cargo
#
# Pamiec:
#   X[0] = energia (0.0-1.0)
#   X[1] = typ zasobu (0=brak, 1=IRON, 2=GOLD, 3=inne)
#   X[2] = kierunek (wynik skanera)
#   X[3] = dystans (wynik skanera)
#   X[10] = ostatni kierunek ruchu
#   X[11] = licznik krokow bez zasobu
# ==============================================

{
    # === TRYB KRYTYCZNY: energia < 20% ===
    IF (0.2 - X[0]) {
        f_0();
    }

    # === TRYB NISKIEJ ENERGII: 20-40% ===
    IF (X[0] - 0.2) {
        IF (0.4 - X[0]) {
            f_2(1.0, 1.0);
            IF (1.5 - X[3]) {
                f_7(1.0);
            }
            f_0();
        }
    }

    # === TRYB NORMALNY: 40-70% ===
    IF (X[0] - 0.4) {
        IF (0.7 - X[0]) {
            f_2(1.0, 1.0);
            IF (1.5 - X[3]) {
                X[11] = 0.0;
                f_7(1.0);
            }
            IF (X[3] - 1.5) {
                IF (8.0 - X[3]) {
                    X[11] = 0.0;
                    X[10] = X[2];
                    f_1(X[2], 1.0);
                }
            }
            X[11] = X[11] + 1.0;
            IF (8.0 - X[11]) {
                f_1(X[10], 1.0);
            }
            IF (X[11] - 8.0) {
                X[11] = 0.0;
                X[10] = X[10] + 1.0;
                IF (X[10] - 3.5) {
                    X[10] = 0.0;
                }
                f_1(X[10], 1.0);
            }
        }
    }

    # === TRYB AGRESYWNY: energia > 70% ===
    IF (X[0] - 0.7) {
        f_2(1.0, 1.0);
        IF (1.5 - X[3]) {
            X[11] = 0.0;
            f_7(1.0);
        }
        IF (X[3] - 1.5) {
            X[11] = 0.0;
            X[10] = X[2];
            f_1(X[2], 2.0);
        }
        X[11] = X[11] + 1.0;
        IF (6.0 - X[11]) {
            f_1(X[10], 2.0);
        }
        IF (X[11] - 6.0) {
            X[11] = 0.0;
            X[10] = X[10] + 1.0;
            IF (X[10] - 3.5) {
                X[10] = 0.0;
            }
            f_1(X[10], 2.0);
        }
    }

    REDO;
}
