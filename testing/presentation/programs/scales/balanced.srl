$PARTS:
1.0, 1.0, 1.5, 1.0, 0.5, 0.5, 1.0;

$PROGRAMM
# ==============================================
# BALANCED - Zbalansowany (wszystkie czesci podobne)
# ==============================================
# Standardowa strategia, referencyjna konfiguracja
# ==============================================

{
    f_2(1.0, 1.0);

    IF (1.5 - X[1]) {
        f_7(1.0);
    }

    IF (X[1] - 1.5) {
        f_1(X[0], 1.0);
    }

    IF (0.0 - X[1]) {
        f_1(0.0, 1.0);
    }

    REDO;
}
