$PARTS:
0.5, 1.5, 3.0, 2.0, 0.5, 0.5, 2.0;

$PROGRAMM
# ==============================================
# STATIC - Statyczny zbieracz
# ==============================================
# Algorytm:
# 1. Jesli zasob blisko (<=2) - zbieraj wielokrotnie
# 2. Co kilka krokow odpoczywaj dla energii
# 3. Poruszaj sie tylko gdy brak zasobow w zasiegu
# 4. Maly silnik (0.5), duzy magazyn (3.0)
#
# Pamiec:
#   X[0] = energia (0.0-1.0)
#   X[1] = kierunek (wynik skanera)
#   X[2] = dystans (wynik skanera)
#   X[30] = licznik zbieran (odpoczywaj co 5)
#
# Idle loop: zapobiegamy przez losowy ruch gdy brak zasobow
# ==============================================

X[30] = 0.0;

# Glowna petla
{
    # Skanuj aby sprawdzic czy jest zasob w poblizu
    f_2(1.0, 1.0);

    # Jesli zasob blisko (<=2) - zbieraj
    IF (2.0 - X[2]) {
        X[30] = X[30] + 1.0;

        # Co 5 zbieran odpoczywaj
        IF (X[30] - 4.5) {
            X[30] = 0.0;
            f_0();
        }

        # Zbieraj duzo na raz (duzy kolektor)
        f_7(2.0);
    }

    # Jesli zasob daleko - idz powoli
    IF (X[2] - 2.0) {
        f_1(X[1], 1.0);
    }

    # Jesli nie znaleziono - maly losowy ruch
    IF (0.0 - X[2]) {
        f_1(0.0, 1.0);
    }

    REDO;
}
