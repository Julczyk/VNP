$PARTS:
2.0, 1.5, 1.5, 1.0, 0.5, 0.5, 1.0;

$PROGRAMM
# ==============================================
# TRAVELER - Podruznik
# ==============================================
# Algorytm:
# 1. Skanuj w poszukiwaniu zasobow
# 2. Jesli blisko - zbieraj
# 3. Jesli daleko - idz SZYBKO (wiekszy silnik)
# 4. Eksploruj wiecej terenu
#
# Pamiec:
#   X[0] = kierunek (wynik skanera)
#   X[1] = odleglosc (wynik skanera)
#   X[20] = licznik krokow w jednym kierunku
# ==============================================

# Glowna petla
{
    # Skanuj otoczenie
    f_2(1.0, 1.0);

    # Jesli zasob blisko (<=1) - zbieraj
    IF (1.5 - X[1]) {
        X[20] = 0.0;
        f_7(1.0);
    }

    # Jesli znaleziono zasob daleko (>1) - idz szybko (dist=3)
    IF (X[1] - 1.5) {
        X[20] = 0.0;
        f_1(X[0], 3.0);
    }

    # Jesli nie znaleziono (X[1] < 0) - eksploruj w aktualnym kierunku
    IF (0.0 - X[1]) {
        X[20] = X[20] + 1.0;

        # Zmien kierunek co 5 krokow
        IF (5.5 - X[20]) {
            f_1(X[0], 2.0);
        }

        # Reset kierunku
        IF (X[20] - 5.5) {
            X[0] = X[0] + 1.0;
            X[20] = 0.0;
            f_1(X[0], 2.0);
        }
    }

    REDO;
}
