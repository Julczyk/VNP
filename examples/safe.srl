$PARTS:
1.0, 1.0, 2.0, 1.0, 0.5, 0.5, 2.5;

$PROGRAMM
# ==============================================
# SAFE - Bezpieczny automat
# ==============================================
# Algorytm:
# 1. Sprawdz energie - jesli niska (<30%) odpoczywaj
# 2. Zbieraj tylko bardzo blisko (<=1)
# 3. Poruszaj sie tylko gdy energia wysoka (>50%)
# 4. Duzy generator energii (2.5) zapewnia ladowanie
#
# Pamiec:
#   X[0] = energia (0.0-1.0, proporcja max)
#   X[1] = typ zasobu (0=brak, 1=IRON, 2=GOLD, 3=inne)
#   X[2] = kierunek (wynik skanera)
#   X[3] = dystans (wynik skanera)
# ==============================================

# Glowna petla
{
    # Jesli energia < 30% - odpoczywaj (laduj)
    IF (0.3 - X[0]) {
        f_0();
    }

    # Skanuj otoczenie
    f_2(1.0, 1.0);

    # Jesli zasob bardzo blisko (<=1) - zbieraj
    IF (1.5 - X[3]) {
        f_7(1.0);
    }

    # Jesli energia > 50% i zasob blisko (1-5) - idz
    IF (X[0] - 0.5) {
        IF (X[3] - 1.5) {
            IF (5.0 - X[3]) {
                f_1(X[2], 1.0);
            }
        }
    }

    # Jesli energia niska lub zasob daleko - odpoczywaj
    IF (0.5 - X[0]) {
        f_0();
    }

    # Jesli nie znaleziono zasobu - odpoczywaj
    IF (0.0 - X[3]) {
        f_0();
    }

    REDO;
}
